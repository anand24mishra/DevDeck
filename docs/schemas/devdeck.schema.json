{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDeck repository config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "expectedPorts", "start"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "profile": { "type": "string", "minLength": 1, "maxLength": 120 },
    "expectedPorts": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "start": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "command": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "cwd": {
            "type": "string",
            "default": ".",
            "description": "Relative directory contained in the repository"
          }
        }
      }
    }
  }
}
